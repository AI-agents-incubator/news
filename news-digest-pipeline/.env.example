# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# На боевом сервере ставьте `production`. Авторизация отключается ТОЛЬКО при
# `development` или `test`; любое другое значение или пусто → авторизация
# ВКЛючена (fail-closed), чтобы мисконфиг не открыл API «по-тихому».
NODE_ENV=development
BASE_URL=https://news.questtales.com
DB_PATH=./data/news-digest.db

# ─── Auth (dashboard + API) ──────────────────────────────────────────────────
API_SECRET_KEY=change-me-to-a-strong-random-key
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# ─── LLM (vendor + model) ────────────────────────────────────────────────────
# LLM_VENDOR selects which API receives requests: anthropic | openai.
# CLAUDE_MODEL holds the active model id for the selected vendor (historical name;
# it is vendor-agnostic — put an OpenAI id here when LLM_VENDOR=openai).
LLM_VENDOR=anthropic
CLAUDE_MODEL=claude-sonnet-4-20250514

ANTHROPIC_API_KEY=sk-ant-...
# Leave *_BASE_URL empty to use the vendor default endpoint. Non-empty values
# are restricted to the official HTTPS endpoint; custom/proxy endpoints are not
# supported because they could receive provider credentials and prompt data.
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
# Reasoning depth for the OpenAI path only. Leave EMPTY to send nothing
# (current default). Suggested values: minimal | low | medium | high.
# An unsupported value is dropped automatically at runtime and retried.
OPENAI_REASONING_EFFORT=

# ─── Queue & generation ──────────────────────────────────────────────────────
# ARTICLE_THRESHOLD and MAX_ARTICLES_PER_DIGEST are DASHBOARD-managed: the
# Settings page writes them to data/settings.env (admin overrides, loaded on top
# of this base env). Do NOT set them here — keep the tunables in one place so the
# base env and the dashboard can't disagree. Code defaults (13 / 17) apply only
# if no override exists.
CHECK_INTERVAL_MS=60000
# Digest worker lease: stale `processing` rows return to the queue after this
# duration. Keep it comfortably above the slowest normal digest generation.
PROCESSING_LEASE_MS=1800000
# How many failed fetch attempts before the local fetcher gives up on an article
# and flips it to the terminal 'unfetchable' status (stops the endless Chrome
# re-open loop on URLs that never yield content).
MAX_FETCH_ATTEMPTS=5
# Debug port for the local fetcher's DEDICATED Chrome (CDP). The fetcher launches
# its own headed, offscreen Chrome (profile ~/.news-fetch-chrome) on this port
# and drives it over the DevTools Protocol — no AppleScript, immune to other
# Chrome instances. Requires Node started with --experimental-websocket
# (set via NODE_OPTIONS in the LaunchAgent). Mac-only; server ignores it.
FETCH_CHROME_PORT=9333
# Active Phase-A scenario: sarcastic (prompt.md) | architect (prompt_deep.md).
ACTIVE_SCENARIO=sarcastic

# ─── Notifications ───────────────────────────────────────────────────────────
NTFY_TOPIC=news-digest-alexkrol

# ─── FB: источник постов ─────────────────────────────────────────────────────
# Read-only поллер профиля УДАЛЁН. FB-посты теперь добавляются вручную по ссылке
# через дашборд (POST /api/source-posts/fetch-url): чтение browserless (без
# headless-браузера) и работает на боевом сервере — никакого 503.
FB_PROFILE_URL=https://www.facebook.com/alex.v.krol

# ─── Publishing: Facebook Page (only Page is supported — no personal profile) ─
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# News Pro moderates Facebook Page comments only. Telegram AI bots are configured
# in the separate AIchatTG project.
MODERATION_MODE=shadow
MODERATION_MODEL=
MODERATION_VENDOR=
MODERATION_IMPROVER_MODEL=
MODERATION_BAN_THRESHOLD=0.85
MODERATION_OWNER_AUTHOR_IDS=
MODERATION_HARD_DELETE=false
MODERATION_POLL_POST_LOOKBACK=5
MODERATION_POLL_INTERVAL_MS=300000

# ─── Publishing: Telegram ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Channel the digest is published to (falls back to TELEGRAM_CHAT_ID if unset).
TELEGRAM_PUBLISH_CHAT_ID=
# Обязателен для приёма новостей из Telegram: без него webhook работает
# fail-closed и отвергает все запросы (403).
TELEGRAM_WEBHOOK_SECRET=

# ─── Publishing: Email (GetResponse, pro) ────────────────────────────────────
# Autoposter создаёт письмо СТРОГО ЧЕРНОВИКОМ (draft) — отправку владелец
# нажимает в самом GetResponse. FROM_FIELD_ID опционален: пусто → берётся
# первый доступный from-field аккаунта.
GETRESPONSE_API_KEY=
GETRESPONSE_CAMPAIGN_ID=
GETRESPONSE_FROM_FIELD_ID=

# ─── Publishing: Substack (private server Chrome, pro) ───────────────────────
# Account cookies remain inside the dedicated persistent Chrome profile.
# The main app talks only to the container-internal bearer-protected service.
# Modes: draft_only | web_only. Substack email sends are always rejected.
SUBSTACK_PUBLISHER_URL=http://substack-publisher:3110
SUBSTACK_PUBLISHER_TOKEN=
SUBSTACK_PUBLICATION_URL=https://biggame.substack.com
SUBSTACK_MODE=draft_only
SUBSTACK_TITLE_PREFIX=[TEST]
SUBSTACK_WEB_PUBLISH_ENABLED=false

# ─── Media generation (optional; preferred custom-visual provider) ───────────
FAL_KEY=

# ─── Publishing: Instagram (Graph API, pro) ──────────────────────────────────
# Autoposter публикует пост картинкой + подписью. Текст после первых 2200
# символов отправляется упорядоченной цепочкой комментариев (каждый <=2200).
# Пост считается отправленным только когда подтверждены и картинка, и все
# комментарии. Перед отправкой части сохраняется durable checkpoint. Потерянный
# ответ сверяется по списку комментариев Meta; неясный результат остаётся
# partial без повторного POST, поэтому продолжение не дублируется. Токен —
# long-lived Instagram Graph API token у IG Business/Creator-аккаунта; для
# чтения и записи комментариев нужны scopes instagram_business_basic и
# instagram_business_manage_comments (сверить по доке Meta перед боем).
# Если в исходном посте нет изображения, Autoposter создаёт один отдельный
# source-grounded JPEG через уже настроенный OPENAI_API_KEY; при наличии FAL_KEY
# используется FAL, а без него — OpenAI Image API. Результат сохраняется в
# data/source-post-images/ и повторно используется на сознательном retry.
# Статичный placeholder намеренно не поддерживается. Для запуска нужны токен,
# account id, BASE_URL и OPENAI_API_KEY; FAL_KEY необязателен.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ─── Publishing: Threads (Graph API, pro) ────────────────────────────────────
# Отдельный access token Threads OAuth и id Threads user. В Meta app должны быть
# включены Threads API / публикация и выданы scopes threads_basic,
# threads_content_publish. Пайплайн создаёт text-container, сохраняет receipt,
# затем делает ОДНУ попытку publish; потерянный ответ остаётся partial до ручной
# сверки, а не повторяется вторым публичным постом.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ─── Planned integrations (status-only stubs — pipelines not implemented) ─────
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
TIKTOK_ACCESS_TOKEN=
GEMINI_API_KEY=
